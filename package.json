{
  "name": "pain-prompt",
  "version": "0.1.0",
  "private": true,
  "description": "Discord bot that asks for injury pain scores and logs them as Intervals.icu notes",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node dist/main.js",
    "dev": "tsx src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "node dist/check.js",
    "check:dev": "tsx src/check.ts"
  },
  "dependencies": {
    "croner": "^10.0.1",
    "discord.js": "^14.27.0",
    "pino": "^9.5.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
