# --- Discord -----------------------------------------------------------------
# Bot token from https://discord.com/developers/applications -> your app -> Bot
DISCORD_BOT_TOKEN=
# Channel the prompts are posted in (Developer Mode -> right-click channel -> Copy Channel ID)
DISCORD_CHANNEL_ID=
# Your own user id (right-click yourself -> Copy User ID). You get @-mentioned,
# and only this user can answer.
DISCORD_USER_ID=

# --- Intervals.icu -----------------------------------------------------------
# Settings -> Developer Settings -> API key. Athlete id looks like i123456.
INTERVALS_API_KEY=
INTERVALS_ATHLETE_ID=

# --- Behaviour (all optional, defaults shown) ---------------------------------
# PAIN_AREA=Groin
# PAIN_TZ=Europe/Oslo
# Morning check, cron in PAIN_TZ (07:10 every day)
# PAIN_MORNING_CRON=10 7 * * *
# How often to look for new runs
# PAIN_POLL_MINUTES=10
# Ask "during the run" as soon as a run shows up
# PAIN_PROMPT_DURING=true
# Follow-up prompt this long after the run ENDED (0 = off)
PAIN_POST_RUN_DELAY_MINUTES=70
# One reminder if still unanswered after this long (0 = off)
# PAIN_REMINDER_MINUTES=45
# Runs that ended more than this long ago when first seen are not prompted
# PAIN_MAX_RUN_AGE_HOURS=12
# Intervals.icu activity types that count as runs
# PAIN_ACTIVITY_TYPES=Run,TrailRun,VirtualRun
# PAIN_STATE_PATH=./data/state.json
# PAIN_LOG_LEVEL=info
